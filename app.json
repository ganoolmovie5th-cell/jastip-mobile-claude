{
  "expo": {
    "name": "Jastipin",
    "slug": "jastip-mobile-claude",
    "owner": "ganoolmovie5th",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "jastipin",
      "id.jastipin.app"
    ],
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.jastipin.app"
    },
    "android": {
      "package": "id.jastipin.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f5c4a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f5c4a"
        }
      ],
      "expo-web-browser",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
